# Copy this file to .env and fill in your addons.mozilla.org API keys:
# https://addons.mozilla.org/developers/addon/api/key/
# .env is in .gitignore; never commit it.
WEB_EXT_API_KEY=user:12345678:123
WEB_EXT_API_SECRET=your-jwt-secret

# Optional, for node scripts/chrome-upload.mjs (Chrome Web Store API):
# CHROME_CLIENT_ID=
# CHROME_CLIENT_SECRET=
# CHROME_REFRESH_TOKEN=
# CHROME_PUBLISHER_ID=
# CHROME_EXTENSION_ID=
