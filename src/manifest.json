{
  "manifest_version": 3,
  "name": "COR3 Companion",
  "version": "1.2.4",
  "description": "ICE WALL pattern highlighter, job tracker with routes and doable jobs, loadout and market upgrade helper, exact expedition risk/rewards and mercenary odds, and inventory prices for cor3.gg.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "COR3 Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "host_permissions": [
    "*://cor3.gg/*",
    "*://*.cor3.gg/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://cor3.gg/*",
        "*://*.cor3.gg/*"
      ],
      "js": [
        "toggles.js",
        "jobs.js",
        "loadout.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://cor3.gg/*",
        "*://*.cor3.gg/*"
      ],
      "js": [
        "solver.js",
        "expeditions.js",
        "stash.js",
        "lighter.js",
        "topbar.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://cor3.gg/*",
        "*://*.cor3.gg/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "icewall-helper@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
